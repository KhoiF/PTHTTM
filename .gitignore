/tmp/

# Microsoft Office temporary files
~$*
*.tmp

# Local one-off helper scripts
.upgrade_accuracy_notebooks.py

# Large local datasets
# GitHub blocks regular Git pushes for files over 100MB.
src/Assignment 03/house_price/data/realtor-data.zip.csv
src/Assignment 04/mnist/data/*
!src/Assignment 04/mnist/data/.gitkeep
src/Assignment 04/cifar10/data/*
!src/Assignment 04/cifar10/data/.gitkeep

# Assignment 05 local datasets
src/Assignment 05/Fashion-MNIST/data/*
!src/Assignment 05/Fashion-MNIST/data/.gitkeep
src/Assignment 05/CIFAR-100/data/*
!src/Assignment 05/CIFAR-100/data/.gitkeep

# Agent 02 optional Kaggle data (simulation does not need it)
src/Agent 02/data/*
!src/Agent 02/data/.gitkeep
